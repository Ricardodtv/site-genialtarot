{
  "name": "site-genialtarot",
  "main": "worker.js",
  "compatibility_date": "2026-07-28",
  "observability": { "enabled": true },
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    // 🚨 08/09/2026 -- SEM ISTO O WORKER NAO CORRE NAS PAGINAS.
    // Por omissao, quando existe um ficheiro que corresponde ao pedido, a
    // Cloudflare serve-o DIRECTAMENTE e nao invoca o worker.
    //
    // A tentativa de 22/08 usou ["/", "/*.html"] e SO O "/" pegou. A razao,
    // percebida hoje: os enderecos deste site nao tem .html -- /horoscopo.html
    // responde 307 para /horoscopo. O padrao "/*.html" nunca correspondia ao
    // que chega mesmo. Por isso agora vai a LISTA COMPLETA, sem wildcards.
    //
    // So o HTML. Imagens, CSS e JS continuam servidos directamente, sem
    // gastar invocacoes do worker.
    "run_worker_first": [
      "/",
      "/anual",
      "/ascendente",
      "/aniversarios",
      "/amor-do-dia",
      "/horoscopo-do-dia",
      "/signo/*",
      "/horoscopo-semanal",
      "/horoscopo-semanal-*",
      "/consulta-de-tarot",
      "/canais-oficiais",
      "/tarot-terapeutico",
      "/tarot-e-autoconhecimento",
      "/horoscopo-de-amanha",
      "/tarot-cigano",
      "/consulta-de-tarot-online",
      "/datas-dos-signos",
      "/signos-que-combinam",
      "/cor-do-ano-2027",
      "/alinhamento-dos-planetas",
      "/astrologia-vedica",
      "/signos-2026",
      "/melhores-signos-2027",
      "/astrologia",
      "/lua-azul",
      "/tiragem-templo-de-afrodite",
      "/combinacoes-de-tarot",
      // 03/11/2026: mais 5 pesquisas a subir no Google Trends
      "/tarot-dos-gatos",
      "/stellium-astrologia",
      "/astrologia-horaria",
      "/astrologia-sideral",
      "/astrologia-sistemica",
      // 04/11/2026: guia grátis para aprender astrologia
      "/aprender-astrologia",
      "/tarot-rider-waite",
      "/tarot-com-inteligencia-artificial",
      "/ceu-de-hoje",
      "/compatibilidade",
      "/noticias-do-ceu",
      "/noticias",
      // 06/11/2026: os 22 arcanos num só padrão, para libertar lugares no limite de 100 regras.
      "/arcano-*",
      // 06/11/2026: os .html passam pelo worker, que troca o 307 da Cloudflare por 301.
      "/*.html",
      "/arcanos",
      "/arvore",
      "/fimdesemana",
      "/horoscopo",
      "/loja",
      "/loja-brasil",
      "/loja-portugal",
      "/ir-loja",
      "/lua",
      "/mapa-amor",
      "/mapa-astral",
      "/numerologia-2027",
      "/tarot-semestral",
      "/novidades",
      "/revolucao-solar",
      "/horoscopo-pessoal",
      "/carta-de-tarot",
      "/retrogrados",
      "/trio-astral",
      "/calendarios",
      "/horoscopo-chines",
      "/fase-lua-nascimento",
      "/adivinha-signo",
      "/mapa-do-casal",
      "/oraculo-cores",
      "/efemerides",
      "/famosos-ceu",
      "/pagar",
      "/privacidade",
      "/sobre",
      "/vip",
      "/tarot-gratis",
      "/termos",
      "/index",
      "/transitos-lentos",
      "/neptuno-em-carneiro",
      "/saturno-em-carneiro",
      "/plutao-em-aquario",
      "/urano-em-gemeos",
      "/jupiter-em-leao",
      "/jupiter-em-virgem",
      "/nodos-lunares-aquario-leao",
      "/saturno-e-urano-2032",
      "/consulta-tarot-casal",
      "/tarot-para-decisoes",
      "/tarot-para-emigrantes",
      "/escolha-um-monte",
      "/astrocartografia",
      "/hipnose"
    ]
  },
  "kv_namespaces": [
    { "binding": "CAPTURAS", "id": "2290d2931e8d4eaf986272a410a2f3ef" }
  ],
  // Onde ficam as visitas contadas pelo proprio worker (ver contarVisita).
  // 31/10/2026: a sala de quem está no site agora + o chat (classe Sala no worker.js)
  "durable_objects": { "bindings": [ { "name": "SALA", "class_name": "Sala" }, { "name": "CONSULTORIO", "class_name": "Consultorio" }, { "name": "CONTAS", "class_name": "Contas" } ] },
  "migrations": [ { "tag": "v1-sala", "new_sqlite_classes": ["Sala"] }, { "tag": "v2-consultorio", "new_sqlite_classes": ["Consultorio"] }, { "tag": "v3-contas", "new_sqlite_classes": ["Contas"] } ],
  "analytics_engine_datasets": [
    { "binding": "VISITAS", "dataset": "visitas_site" }
  ]
}
